{
  "name": "command-center",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Project & Delivery Command Center - Phase 1",
  "type": "module",
  "engines": {
    "node": ">=22.x"
  },
  "scripts": {
    "dev:server": "tsx watch server/src/server.ts",
    "dev:client": "vite",
    "dev": "tsx watch server/src/server.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "test": "node --import tsx --test --test-concurrency=1 server/tests/*.test.ts",
    "db:migrate": "tsx server/src/db/migrate.ts",
    "db:seed": "tsx server/src/db/seed.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
